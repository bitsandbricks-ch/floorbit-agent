# Settings for the local agent (compose.yml, docs/agent.md). Copy to agent.env.
# Keep agent.env readable only by you: it holds the agent key.

# The hosted Floorbit, and the key from its Settings > Local agents (shown once when enrolling).
FLOORBIT_URL=https://floor.example.com
FLOORBIT_AGENT_KEY=
# Or read it from a file. A self-hosted Floorbit writes one into a volume the two share and enrols
# the agent itself (its docker-compose.yml); the agent waits up to two minutes for it.
# FLOORBIT_AGENT_KEY_FILE=/run/floorbit-agent/local-agent.key

# The settings below can also be set on the agent's page in the hosted Floorbit (Local agents, the
# agent, Settings); a variable set here wins. Not the ones marked "hall only": Floorbit can't set those.
#
# Everything else is set up in the hosted Floorbit, Settings > Plugins, and the agent takes it from
# there: LibreNMS, NetBox, health checks, syslog and NetFlow from the hall, the check-in note on
# phones, the attendees' front door. For syslog, flows, the note or the front door, also publish
# their ports in compose.yml. LIBRENMS_URL, NETBOX_URL, FLOORBIT_PLUGIN_*, FLOORBIT_AGENT_PLUGINS and
# FLOORBIT_AGENT_SYSLOG_PORT and the like are no longer read: an agent that still has them hands
# them to the hosted Floorbit once (README.md, "Settings from an older agent").

# The Telemetry plugin runs Telegraf inside the agent (it is in the image). To keep it in a
# container of its own instead, as before: sidecar (the agent then only writes its config).
#FLOORBIT_TELEGRAF=sidecar
# The port Telegraf (and a firewall's own Telegraf) posts to.
#FLOORBIT_TELEMETRY_PORT=8186

# Actions that change something in the hall (clearing the LAN cache) run only when allowed here,
# by name: plugin.action, plugin.* or *.
# (hall only)
#FLOORBIT_AGENT_ALLOW_ACTIONS=lancache.clear_cache
# Plugin updates come signed from the hosted Floorbit; only bundles signed with the key in this
# image and newer than what runs are installed. auto (default), approve (then:
# python -m floorbit_agent plugins approve <id>) or off.
# (hall only)
#FLOORBIT_AGENT_PLUGIN_UPDATES=auto
# Optional: a certificate for the plugins' listeners in the hall (the front door, the telemetry
# listener a firewall's Telegraf posts to). Without one they answer plain HTTP; crew sign-in
# through the front door needs HTTPS.
#FLOORBIT_AGENT_TLS_CERT=/certs/agent.pem
#FLOORBIT_AGENT_TLS_KEY=/certs/agent-key.pem

# Optional: game servers are asked only at private addresses. To allow other networks (or only
# some), list them; the list replaces the default.
# (hall only)
#FLOORBIT_AGENT_GAME_NETS=10.10.0.0/16,192.0.2.0/24

# Optional: switch logins (port actions, commands, config backups, the terminal) go only to private
# addresses. To allow other networks (or only some), list them; the list replaces the default.
# (hall only)
#FLOORBIT_AGENT_SWITCH_NETS=10.10.0.0/16

# Optional: the services view's probes (DNS queries, TCP connects to 53/80/443/853) go to any address
# but this machine's own. To allow only some networks, list them.
# (hall only)
#FLOORBIT_AGENT_PROBE_NETS=198.51.100.0/24,192.0.2.53/32

# What the plugins send (syslog, flow summaries, ...) waits on disk while the hosted Floorbit can't
# take it, up to this much and this long for each plugin.
#FLOORBIT_AGENT_BUFFER_MAX_MB=2048
#FLOORBIT_AGENT_BUFFER_MAX_HOURS=24

# /metrics and /healthz for Prometheus (README.md, "Monitor it"): host:port, or off.
#FLOORBIT_AGENT_METRICS=0.0.0.0:9520
# Ask scrapers for "Authorization: Bearer <token>" (set it when the port is reachable from the LAN).
#FLOORBIT_AGENT_METRICS_TOKEN=

# Where laptops in the hall reach the check-in note's port, for the crew's seat walk-through (it
# identifies the laptop's own IP when Floorbit only sees the hall's public address).
#FLOORBIT_AGENT_LAN_URL=http://192.0.2.10:8908

# Optional: share virtual IPs with the other agents (VRRP, docs/vrrp.md). Start with
# compose.vrrp.yml as well. The same VIPs and ID on every agent; PREFER differs.
#FLOORBIT_AGENT_VRRP_VIPS=192.0.2.10/24,192.0.2.11/24
#FLOORBIT_AGENT_VRRP_INTERFACE=eth0
# Which VIPs this agent holds while it is up, by position: 1 on the first agent, 2 on the second.
#FLOORBIT_AGENT_VRRP_PREFER=1
# The first VIP's virtual router ID (the next VIPs take the next numbers); unique on the VLAN.
#FLOORBIT_AGENT_VRRP_ID=51
# The other agents' addresses, where the network drops multicast (VRRP then goes unicast).
#FLOORBIT_AGENT_VRRP_PEERS=192.0.2.2

# Settings for the local agent (compose.yml, docs/agent.md). Copy to agent.env.
# Keep agent.env readable only by you: it holds the agent key and the LibreNMS and NetBox tokens.

# The hosted Floorbit, and the key from its Settings > Local agents (shown once when enrolling).
FLOORBIT_URL=https://floor.example.com
FLOORBIT_AGENT_KEY=

# The event's LibreNMS: switch status, ports, ARP.
LIBRENMS_URL=https://librenms.example.com
LIBRENMS_TOKEN=

# Optional: the event's NetBox, for the inventory.
#NETBOX_URL=https://netbox.example.com
#NETBOX_TOKEN=

# Optional: health checks from inside the hall, for the hosted health wall.
#FLOORBIT_AGENT_PLUGINS=http-check

# Optional, instead of LibreNMS: device telemetry straight from the switches and firewalls
# (Telegraf next to the agent: docker compose --profile telemetry up -d). Leave LIBRENMS_URL
# empty, turn on the Telemetry plugin in the hosted Floorbit and add the devices there.
#FLOORBIT_AGENT_PLUGINS=telemetry
#FLOORBIT_TELEMETRY_PORT=8186

# Agent plugins are turned on and set up in the hosted Floorbit (Settings > Plugins). Actions that
# change something in the hall (clearing the LAN cache) run only when allowed here, by name:
# plugin.action, plugin.* or *.
#FLOORBIT_AGENT_ALLOW_ACTIONS=lancache.clear_cache
#FLOORBIT_PLUGIN_HTTP_CHECK_TARGETS=Cache=http://cache.lan.example/health,Panel=http://panel.lan.example/

# Optional: game servers are asked only at private addresses. To allow other networks (or only
# some), list them; the list replaces the default.
#FLOORBIT_AGENT_GAME_NETS=10.10.0.0/16,192.0.2.0/24

# Optional: the services view's probes (DNS queries, TCP connects to 53/80/443/853) go to any address
# but this machine's own. To allow only some networks, list them.
#FLOORBIT_AGENT_PROBE_NETS=198.51.100.0/24,192.0.2.53/32

# Optional: take the event's syslog and send it on to the hosted Logs page (publish the port in
# compose.yml, then point the switches at this machine).
#FLOORBIT_AGENT_SYSLOG_PORT=5514

# Syslog the hosted Floorbit can't take yet waits on disk, up to this much and this long (0 MB: off).
#FLOORBIT_AGENT_BUFFER_MAX_MB=2048
#FLOORBIT_AGENT_BUFFER_MAX_HOURS=24

# /metrics and /healthz for Prometheus (README.md, "Monitor it"): host:port, or off.
#FLOORBIT_AGENT_METRICS=0.0.0.0:9520
# Ask scrapers for "Authorization: Bearer <token>" (set it when the port is reachable from the LAN).
#FLOORBIT_AGENT_METRICS_TOKEN=

# Optional: collect NetFlow / IPFIX for the hosted Traffic page; only the summary leaves this machine.
#FLOORBIT_AGENT_FLOWS_PORT=2055

# Optional: answer the Captive Portal API (RFC 8908) for DHCP option 114: a quiet "sign in to network"
# note until the seat checked in, never a block. Serve it behind the event's HTTPS reverse proxy.
#FLOORBIT_AGENT_CAPTIVE=0.0.0.0:8908
#FLOORBIT_AGENT_CAPTIVE_PROXIES=192.0.2.2
#FLOORBIT_AGENT_CAPTIVE_PORTAL_URL=

# Optional: share virtual IPs with the other agents (VRRP, docs/vrrp.md). Start with
# compose.vrrp.yml as well. The same VIPs and ID on every agent; PREFER differs.
#FLOORBIT_AGENT_VRRP_VIPS=192.0.2.10/24,192.0.2.11/24
#FLOORBIT_AGENT_VRRP_INTERFACE=eth0
# Which VIPs this agent holds while it is up, by position: 1 on the first agent, 2 on the second.
#FLOORBIT_AGENT_VRRP_PREFER=1
# The first VIP's virtual router ID (the next VIPs take the next numbers); unique on the VLAN.
#FLOORBIT_AGENT_VRRP_ID=51
# The other agents' addresses, where the network drops multicast (VRRP then goes unicast).
#FLOORBIT_AGENT_VRRP_PEERS=192.0.2.2
